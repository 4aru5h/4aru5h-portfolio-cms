# Server Configuration
PORT=5000
NODE_ENV=development

# Session secret (must be a random string >= 32 characters in production)
SESSION_SECRET=change-this-to-a-random-string-at-least-32-chars

# Admin Setup & Password Management
# Used during first-time bootstrap or via 'npm run admin:reset'
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-admin-password-here

# Client URL for CORS & CSRF origin verification (comma-separated if multiple)
CLIENT_URL=http://localhost:5173

# Optional: Custom database file location (defaults to database/portfolio.db)
# DATABASE_PATH=database/portfolio.db

# Optional: Reverse Proxy & Client Serving
# TRUST_PROXY=1
# SERVE_CLIENT=false
